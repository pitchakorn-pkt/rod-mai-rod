# คัดลอกเป็น .env แล้วใส่ค่าจริง ห้าม commit .env

# ---- ที่อยู่ของแต่ละ service ภายใน Docker (ห้ามใส่พอร์ต 8001-8006 ตรงนี้) ----
API_BACKEND_URL=http://api-backend:8000
ROUTING_ENGINE_URL=http://routing-engine:8000
WEATHER_DISASTER_URL=http://weather-disaster:8000
RISK_DECISION_URL=http://risk-decision:8000
ASSISTANT_AGENT_URL=http://assistant-agent:8000
SAFETY_KNOWLEDGE_URL=http://safety-knowledge:8000

# frontend ฝั่ง server ใช้ส่งต่อ /api/v1/* (ถ้ารัน Next.js นอก Docker ให้เปลี่ยนเป็น http://localhost:8001)
API_INTERNAL_URL=http://api-backend:8000

# ใช้ข้อมูลที่บันทึกไว้แทนการเรียก API ภายนอก (วันนำเสนอถ้าเน็ตไม่ดี)
DEMO_MODE=false

# ---- Postgres ----
POSTGRES_USER=rodmairod
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rodmairod
# ใน Docker ใช้ postgres:5432 ถ้ารัน api-backend นอก Docker ให้ใช้ localhost:5433
DATABASE_URL=postgresql://rodmairod:changeme@postgres:5432/rodmairod

# ---- Auth ----
JWT_SECRET=changeme-use-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- API ภายนอก ----
# ผู้ให้บริการเส้นทาง: osrm (ไม่ต้องใช้ key และหาเส้นทางสำรองระยะไกลได้), ors หรือ longdo
ROUTING_PROVIDER=osrm
ROUTING_FALLBACK_PROVIDER=ors
OSRM_BASE_URL=https://router.project-osrm.org
LONGDO_MAP_API_KEY=
OPENROUTESERVICE_API_KEY=
THAIWATER_API_KEY=
TMD_API_KEY=
# น้ำท่วมจากดาวเทียม GISTDA (สมัครฟรีที่ api-gateway.gistda.or.th) ว่าง = ไม่มีหมุดน้ำท่วม GISTDA
GISTDA_API_KEY=

# ---- LLM ----
# ลองตัวหลักก่อน แล้วไล่ตัวสำรองตามลำดับ (คั่นด้วยจุลภาค) ตัวที่ไม่มี key หรือชื่อโมเดลจะถูกข้าม
LLM_PRIMARY=groq
LLM_FALLBACK=gemini,groq2
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq จำกัดโควตาแยกตามโมเดล ใช้ key เดียวกับข้างบนได้
GROQ2_API_KEY=
GROQ2_MODEL=openai/gpt-oss-120b
GROQ2_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# login ด้วย Google: OAuth Client ID ชนิด Web application จาก Google Cloud (ไม่ใช่ความลับ)
# ใส่ origin ของเว็บใน Authorized JavaScript origins ด้วย ว่าง = หน้า login ไม่แสดงปุ่ม Google
GOOGLE_CLIENT_ID=
